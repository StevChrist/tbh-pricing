# TBH Inventory Price Tracker — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# ===== Application =====
APP_NAME="TBH Inventory Price Tracker"
DEBUG=false

# ===== Security =====
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ===== CORS =====
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ===== Steam =====
STEAM_APP_ID=3678970

# ===== Database =====
# Used for local development. Docker Compose overrides this automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tbh_price

# ===== PostgreSQL (Docker) =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=tbh_price

# ===== SMTP — Email Sending =====
# Leave SMTP_HOST blank to disable email features (OTP, notifications, etc.)
# If using Gmail, create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ===== OTP — One-Time Passwords =====
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESEND=3
